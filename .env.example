# Copy to .env and fill in real values. Never commit .env — see .gitignore.
# Nothing here is required to run `make seed` / local pipeline; cloud vars
# are only needed once you provision terraform/environments/dev.

# ---- Kaggle (dataset download) ----
# Only needed if you use the Kaggle CLI (Option A in DATA_MODEL.md) instead
# of kagglehub's browser login flow.
KAGGLE_USERNAME=
KAGGLE_KEY=

# ---- Local stack (docker-compose defaults, override if needed) ----
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
POSTGRES_URI=postgresql://platform:platform@localhost:5432/customer_intelligence
MLFLOW_TRACKING_URI=http://localhost:5000

# ---- Azure ----
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=customer-platform
AZURE_KEY_VAULT_URI=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ---- Databricks ----
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=customer_intelligence
DATABRICKS_HTTP_PATH=

# ---- Snowflake ----
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=CUSTOMER_INTELLIGENCE_WH
SNOWFLAKE_DATABASE=CUSTOMER_INTELLIGENCE

# ---- Power BI ----
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=

# ---- MCP / Agents ----
ANTHROPIC_API_KEY=
MCP_SERVER_PORT=8765

# ---- AWS (portability target, optional — see cloud/architecture-comparison.md) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=sa-east-1
