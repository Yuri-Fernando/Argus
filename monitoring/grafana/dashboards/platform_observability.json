{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Local docker-compose Prometheus instance, port 9090 — see monitoring/prometheus/prometheus.yml",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Pipeline duration (p50/p95)",
      "description": "Bronze -> Silver -> Gold job duration, per source. Matches pipeline_duration in ARCHITECTURE.md §17.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(pipeline_duration_seconds_bucket[5m])) by (le, source))",
          "legendFormat": "p50 — {{source}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(pipeline_duration_seconds_bucket[5m])) by (le, source))",
          "legendFormat": "p95 — {{source}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Data Quality score (overall)",
      "description": "Rolled-up dq_score published by data_quality/run_checkpoint.py — ARCHITECTURE.md §7.",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.8 },
              { "color": "green", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "avg(dq_score)",
          "legendFormat": "dq_score",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "ML inference latency (p95)",
      "description": "Churn/segmentation model serving latency. Matches ml_latency in ARCHITECTURE.md §17.",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "ms" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ml_latency_milliseconds_bucket[5m])) by (le, model))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Agent latency (p95, by agent)",
      "description": "End-to-end response time per LangGraph agent (Customer Intelligence, Data Quality, Recommendation, Monitoring). Matches agent_latency in ARCHITECTURE.md §17.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(agent_latency_seconds_bucket[5m])) by (le, agent))",
          "legendFormat": "{{agent}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "MCP calls (rate, by tool)",
      "description": "Custom MCP server tool-call rate. Matches mcp_calls in ARCHITECTURE.md §17.",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars" } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(mcp_calls_total[5m])) by (tool)",
          "legendFormat": "{{tool}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "LLM token usage (rate, by agent + token type)",
      "description": "Azure OpenAI / Cortex token consumption, feeds the FinOps cost-per-agent-request metric. Matches llm_tokens in ARCHITECTURE.md §17.",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(llm_tokens_total[5m])) by (agent, token_type)",
          "legendFormat": "{{agent}} — {{token_type}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["customer-intelligence", "platform-observability", "finops"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Platform Observability",
  "description": "Mirrors the Power BI 'Platform Observability' page (ARCHITECTURE.md §13) — pipeline health, DQ score, ML/agent latency, MCP calls, LLM token cost. Built Sprint 16.",
  "uid": "platform-observability",
  "version": 1,
  "weekStart": ""
}
